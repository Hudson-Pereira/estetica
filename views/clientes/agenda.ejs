<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/style.css">

    <title>Estética</title>
</head>
<body>
    <%- include('../includes/clientHeader'); %>
        <section id="divBusca">
            <form action="/cliente/search" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="date" id="txtBusca" name="search" placeholder="Buscar..." />
                <button type="submit" id="search"><img src="/public/images/icons8-pesquisar-sf-black-16.png" id="btnBusca"
                        alt="Buscar" /></button>
                </form>
        </section>
<main class="agenda">
    <h1>Agendamentos</h1>
    <div class="linha-cards agenda-list" id="agendaList"></div>
    <div id="agendaScrollSentinel" aria-hidden="true"></div>
    <p id="agendaEmptyState" class="agenda-empty" hidden>Nenhum agendamento encontrado.</p>
    <p id="agendaLoadingHint" class="agenda-loading" hidden>Carregando mais...</p>
    <button id="scrollTopBtn" class="scroll-top-btn" type="button" aria-label="Voltar ao topo">↑</button>

    <script id="agendaData" type="application/json"><%- JSON.stringify(agenda).replace(/</g, '\\u003c') %></script>

    <template id="agendaCardTemplate">
        <section class="agenda-card">
            <div class="agenda-card-content">
                <div class="agenda-name-wrap">
                    <span class="agenda-name" tabindex="0"></span>
                    <span class="agenda-name-tooltip" role="tooltip"></span>
                </div>
                <div class="agenda-date"></div>
                <div class="agenda-time"></div>
            </div>
        </section>
    </template>
    <script src="/public/js/clientAgendaScript.js"></script>
</main>

    <%- include('../includes/clientFooter'); %>
</body>
</html>
