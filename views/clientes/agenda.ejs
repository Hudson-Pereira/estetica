<main class="agenda">
    <h1>Agendamentos</h1>
    <div class="linha-cards">
        <% agenda.forEach(item => { %>
            <section id="dados">
                <div id="detalhes">
                    <div id="dadosAgenda">
                        <div><%= item.nome %></div>
                        <div><%= item.data %></div>
                        <div><%= item.hora %></div>
                    </div>
                </div>
            </section>
        <% }) %>
    </div>
</main>

    <%- include('../includes/clientFooter'); %>
</body>
