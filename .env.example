# Variáveis de Ambiente - Segurança

# Porta do servidor
PORT=3000

# Host para o servidor (localhost para segurança, 0.0.0.0 apenas em desenvolvimento)
HOST=localhost

# Ambiente (production ou development)
NODE_ENV=development

# Banco de dados MongoDB
# Production: mongodb+srv://user:password@seu-cluster.mongodb.net/database
# Development: mongodb://localhost:27017/servicehub
DATABASE_URL="mongodb+srv://user:password@seu-cluster.mongodb.net/servicehub"

# ⚠️ OBRIGATÓRIO configurar em produção ⚠️
# Credenciais de Admin - GERE UMA CHAVE SEGURA E ÚNICA
# Para gerar o hash da senha, use: https://bcrypt-generator.com/
# Exemplo de gerar hash via Node.js:
#   const bcrypt = require('bcryptjs');
#   bcrypt.hash('sua_senha', 10, (err, hash) => console.log(hash));

ADMIN_USERNAME="seu_usuario_admin_aqui"
ADMIN_PASSWORD_HASH="$2a$10$SEU_HASH_BCRYPT_AQUI"
ADMIN_EMAIL="admin@seudominio.com"

# Secret para sessão - GERE UMA CHAVE SEGURA E ÚNICA
# Mínimo 32 caracteres: use https://www.uuidgenerator.net/ ou:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="seu_secret_muito_longo_e_seguro_com_minimo_32_caracteres_aleatorio"

# ==========================================
# 🔒 IMPORTANTE - Boas práticas de segurança:
# ==========================================
# 1. Nunca commitar este arquivo com valores reais no git
# 2. Usar .env.local ou .env.production apenas localmente
# 3. Em produção, configurar as variáveis direto no servidor/hosting
# 4. Regenerar SESSION_SECRET para cada deploy
# 5. Usar senhas fortes para ADMIN_PASSWORD (mínimo 12 caracteres)
# 6. Configurar NODE_ENV=production em produção
# 7. Usar HOST=localhost exceto se necessário exposição externa
